{
  "name": "jina",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev --filter=@jina/api --filter=@jina/dashboard",
    "simulate:pr-review": "pnpm --filter @jina/workflows simulate:pr-review",
    "review:pr": "pnpm --filter @jina/workflows review:pr"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "turbo": "latest",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
