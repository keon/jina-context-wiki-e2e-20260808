{
  "name": "jina",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && pnpm lint:dead-code && pnpm format:check",
    "lint:dead-code": "knip",
    "lint:fix": "turbo run lint -- --fix && pnpm format",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test": "turbo run test --filter=!@jina/api --filter=!@jina/db && pnpm --filter @jina/db test && pnpm --filter @jina/api test && pnpm test:harnesses",
    "test:harnesses": "node --test scripts/*.test.mjs",
    "dev": "turbo run dev --filter=@jina/api --filter=@jina/dashboard",
    "simulate:pr-review": "pnpm --filter @jina/workflows simulate:pr-review",
    "review:pr": "pnpm --filter @jina/workflows review:pr",
    "evaluate:context-board-quality": "pnpm --filter @jina/context-engine build && node scripts/context-board-quality.mjs",
    "evaluate:questions": "node scripts/context-question-evaluation.mjs",
    "test:context-board-quality": "pnpm --filter @jina/context-engine build && node --test scripts/context-board-quality.test.mjs",
    "evaluate:context-surface": "node scripts/context-surface-e2e.mjs",
    "test:context-surface": "node --test scripts/context-surface-e2e.test.mjs",
    "evaluate:context-security-load": "node scripts/context-security-load-e2e.mjs",
    "test:context-security-load": "node --test scripts/context-security-load-e2e.test.mjs",
    "evaluate:context-postgres-auth": "pnpm --filter @jina/api build && node scripts/context-postgres-auth-e2e.mjs",
    "evaluate:context-trigger-admission": "node scripts/context-trigger-admission-e2e.mjs",
    "test:context-trigger-admission": "node --test scripts/context-trigger-admission-e2e.test.mjs",
    "evaluate:context-production-triggers": "node scripts/context-production-trigger-e2e.mjs",
    "test:context-production-triggers": "node --test scripts/context-production-trigger-e2e.test.mjs",
    "evaluate:context-daytona-board-stage": "DAYTONA_API_KEY= pnpm --filter @jina/daytona build && DAYTONA_API_KEY= pnpm --filter @jina/worker build && node scripts/context-daytona-board-stage-e2e.mjs",
    "test:context-daytona-board-stage": "pnpm --filter @jina/daytona build && pnpm --filter @jina/worker build && node --test scripts/context-daytona-board-stage-e2e.test.mjs",
    "evaluate:context-chaos": "pnpm --filter @jina/board build && pnpm --filter @jina/context-engine build && pnpm --filter @jina/db build && pnpm --filter @jina/daytona build && pnpm --filter @jina/api build && pnpm --filter @jina/worker build && node scripts/context-chaos-acceptance.mjs",
    "test:context-chaos": "pnpm --filter @jina/board build && pnpm --filter @jina/context-engine build && pnpm --filter @jina/db build && node --test scripts/context-chaos-acceptance.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "knip": "^6.29.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
