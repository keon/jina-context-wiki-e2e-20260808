{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["codex"],
  "workspaces": {
    ".": {
      "entry": ["autumn.config.ts", "evals/review/run-isolated-review.mjs", "scripts/context-production-preflight.mjs"],
      "ignoreDependencies": ["pg"]
    },
    "apps/api": {
      "entry": [
        "src/dev-server.ts",
        "src/product/index.ts",
        "src/product/migrate.ts",
        "src/product/migrate-all.ts",
        "src/product/database-cutover.ts",
        "src/product/backfill-internal-users.ts",
        "src/product/rollback-tenant-installation.ts",
        "src/product/sync-github-webhook.ts",
        "src/**/*.test.ts"
      ]
    },
    "apps/worker": {
      "entry": ["src/server.ts", "src/acceptance.ts", "src/**/*.test.ts"]
    },
    "apps/workflows": {
      "entry": ["src/cli/review-pr.ts", "src/simulations/pr-review-trace.ts"]
    },
    "packages/review-agent": {
      "entry": ["src/index.ts", "src/review/codex-review.ts", "src/**/*.test.ts"]
    },
    "packages/db": {
      "entry": [
        "src/migrate.ts",
        "src/migrate-causal-graph.ts",
        "src/activate-causal-graph-release.ts",
        "src/reset-context-data.ts",
        "src/**/*.test.ts"
      ]
    }
  }
}
