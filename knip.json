{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["platform/v1/**", "apps/dashboard/src/v1/**", ".github/workflows/**"],
  "ignoreBinaries": ["codex"],
  "workspaces": {
    ".": {
      "entry": ["scripts/context-production-preflight.mjs"],
      "ignoreDependencies": ["pg"]
    },
    "apps/api": {
      "entry": ["src/dev-server.ts", "src/**/*.test.ts"]
    },
    "apps/worker": {
      "entry": ["src/server.ts", "src/acceptance.ts", "src/**/*.test.ts"]
    },
    "apps/workflows": {
      "entry": ["src/cli/review-pr.ts", "src/simulations/pr-review-trace.ts"]
    },
    "packages/db": {
      "entry": [
        "src/migrate.ts",
        "src/migrate-causal-graph.ts",
        "src/activate-causal-graph-release.ts",
        "src/reset-context-data.ts",
        "src/**/*.test.ts"
      ]
    }
  }
}
