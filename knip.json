{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["codex"],
  "workspaces": {
    "apps/api": {
      "entry": ["src/dev-server.ts", "src/**/*.test.ts"]
    },
    "apps/worker": {
      "entry": ["src/server.ts", "src/acceptance.ts", "src/**/*.test.ts"]
    },
    "apps/workflows": {
      "entry": [
        "src/cli/review-pr.ts",
        "src/simulations/pr-review-simulation.test.ts",
        "src/simulations/pr-review-trace.ts"
      ]
    },
    "packages/db": {
      "entry": ["src/migrate.ts", "src/**/*.test.ts"]
    }
  }
}
