{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["autumn.config.ts", "scripts/context-production-preflight.mjs", "scripts/verify-trigger-project.mjs"],
      "ignoreDependencies": ["pg"]
    },
    "apps/api": {
      "entry": [
        "src/dev-server.ts",
        "src/product/index.ts",
        "src/product/migrate.ts",
        "src/product/migrate-all.ts",
        "src/product/sync-github-webhook.ts",
        "src/**/*.test.ts"
      ]
    },
    "apps/worker": {
      "entry": ["src/server.ts", "src/acceptance.ts", "src/**/*.test.ts"]
    },
    "packages/theme": {},
    "packages/ui": {
      "entry": ["src/**/*.test.tsx", "testing/**"]
    },
    "apps/dashboard": {
      "entry": [
        "src/app/**/{page,layout,not-found,error,loading,route}.{ts,tsx}",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/testing/**"
      ]
    },
    "apps/admin": {
      "entry": [
        "app/**/{page,layout,not-found,error,loading,route}.{ts,tsx}",
        "lib/**/*.test.ts",
        "app/**/*.test.tsx",
        "testing/**"
      ]
    },
    "packages/review-agent": {
      "entry": ["src/index.ts", "src/review/codex-review.ts", "src/**/*.test.ts"]
    },
    "packages/db": {
      "entry": [
        "src/migrate.ts",
        "src/migrate-causal-graph.ts",
        "src/activate-causal-graph-release.ts",
        "src/**/*.test.ts"
      ]
    },
    "trigger": {
      "entry": ["trigger.config.ts", "src/trigger/*.ts", "src/**/*.test.ts"],
      "ignoreDependencies": ["busboy", "trigger.dev"],
      "ignoreBinaries": ["trigger"]
    }
  }
}
