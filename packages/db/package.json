    "test": "pnpm build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@jina/context-engine": "workspace:*",
    "@jina/shared-kernel": "workspace:*",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
