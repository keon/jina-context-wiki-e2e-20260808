{
  "name": "@jina/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "migrate": "pnpm build && node dist/migrate.js",
    "reset-context": "pnpm build && node dist/reset-context-data.js",
    "test": "pnpm build && node --test --test-concurrency=1 dist/*.test.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@jina/context-engine": "workspace:*",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
