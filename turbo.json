{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "INTERNAL_API_TOKEN",
        "JINA_API_URL",
        "JINA_TENANT_ID",
        "JINA_WEB_AUTH_PASSWORD",
        "JINA_WEB_AUTH_USERNAME",
        "JINA_WEB_PRINCIPAL_ID",
        "NEXT_PUBLIC_API_BASE_URL",
        "NEXT_PUBLIC_DASHBOARD_LOCAL_FIXTURE"
      ],
      "outputs": ["dist/**", ".next/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
