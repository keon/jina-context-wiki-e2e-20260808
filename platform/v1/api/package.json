{
  "name": "jina-code-review-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "sync:webhook": "tsx src/sync-github-webhook.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "identity:backfill": "tsx src/backfill-internal-users.ts",
    "tenant-installation:rollback": "tsx src/rollback-tenant-installation.ts",
    "test": "node --test --import tsx src/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "hono": "^4.12.33",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
