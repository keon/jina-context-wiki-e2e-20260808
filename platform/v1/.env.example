# TypeScript API
PORT=8080
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nreplace-with-private-key\n-----END RSA PRIVATE KEY-----"
# Preferred: set the app slug and let the API build the install URL.
GITHUB_APP_SLUG=
# Optional override when GitHub requires a custom install URL.
GITHUB_APP_INSTALL_URL=
# Optional. If unset, `npm run sync:webhook` discovers the active ngrok HTTPS URL.
WEBHOOK_PUBLIC_URL=
GITHUB_WEBHOOK_PATH=/webhooks/github
INTERNAL_API_TOKEN=replace-with-random-internal-service-token
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jina_code_review
# Base64-encoded 32 bytes used to encrypt provider keys and session tokens at rest.
# Generate with: openssl rand -base64 32
# When unset, secrets are stored as plaintext (acceptable for local dev only).
SECRETS_ENCRYPTION_KEY=
DASHBOARD_URL=http://localhost:3000
# Optional comma-separated extra dashboard origins. DASHBOARD_URL is always allowed.
DASHBOARD_ORIGIN=

# Dashboard GitHub OAuth. Leave DASHBOARD_AUTH_MODE=disabled for local unauthenticated dev.
# Set mode to github when these OAuth app credentials are configured.
DASHBOARD_AUTH_MODE=disabled
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_SCOPES=read:user read:org repo
DASHBOARD_SESSION_COOKIE=jina_dashboard_session
DASHBOARD_SESSION_TTL_SECONDS=604800
# For cross-site deployed dashboard/API cookies use: DASHBOARD_COOKIE_SAMESITE=None and DASHBOARD_COOKIE_SECURE=true.
DASHBOARD_COOKIE_SAMESITE=Lax
DASHBOARD_COOKIE_SECURE=false

# Trigger.dev
TRIGGER_SECRET_KEY=tr_dev_replace_me
TRIGGER_API_URL=https://api.trigger.dev
DAYTONA_API_KEY=
OPENAI_API_KEY=
CODEX_REVIEW_TIMEOUT_MS=600000
CODEGRAPH_TIMEOUT_MS=120000
# Model settings for active review-context and runtime-review Codex phases.
# REVIEW_CODEX_EFFORT is optional (low|medium|high); unset = Codex default.
REVIEW_CODEX_MODEL=gpt-5.5
# REVIEW_CODEX_EFFORT=
RUNTIME_PLANNER_MODEL=gpt-5.5
RUNTIME_AGENT_MODEL=gpt-5.4
RUNTIME_MENTAL_TRACE_MODEL=gpt-5.4-mini
# Optional local-only fallback before the GitHub App has Contents: read approved.
GITHUB_CLONE_TOKEN=

# Daytona sandbox sizing. By default workers use the bash-capable
# node:22-bookworm image with the maximum supported profile for this Daytona
# account: 4 vCPU, 8 GiB memory, and 10 GiB storage. Set DAYTONA_SANDBOX_IMAGE
# to another Debian/Ubuntu-based node+git image, or DAYTONA_SNAPSHOT to use a
# pre-baked snapshot with bash installed.
# DAYTONA_SANDBOX_IMAGE=node:22-bookworm
# DAYTONA_SANDBOX_CPU=4
# DAYTONA_SANDBOX_MEMORY=8
# DAYTONA_SANDBOX_DISK=10
# DAYTONA_SNAPSHOT=
DAYTONA_RESULT_DOWNLOAD_TIMEOUT_SECONDS=120
# Skip the per-stage npm install when the image/snapshot pre-bakes worker deps.
# DAYTONA_SKIP_INSTALL=false

# Trigger.dev task project
TRIGGER_PROJECT_REF=proj_replace_me
API_BASE_URL=http://localhost:8080

GOOGLE_CLOUD_PROJECT=
# Read-only repository graph service. Configure both values to enable the dashboard Graph page.
# The API token stays in the server runtime and is never exposed to the browser.
JINA_GRAPH_API_URL=
JINA_GRAPH_API_TOKEN=
JINA_GRAPH_REQUEST_TIMEOUT_MS=20000

# V2 Context MCP is attached by default when the exact repository has a published release.
# The API mints an exact-repository V2 token; Daytona connects directly to V2 /mcp.
# This is separate from the local CodeGraph CLI. Set false only as an emergency kill switch.
JINA_GRAPH_MCP_ENABLED=true
