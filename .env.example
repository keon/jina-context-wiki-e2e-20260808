# Required for POST /webhooks/github. Use the same high-entropy value in the GitHub App.
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret

# Service credentials. INTERNAL_API_TOKEN authorizes board/worker/admin traffic,
# including /internal/context/access/sync. That synchronization route is bound
# server-side to JINA_CONTEXT_TENANT_ID/JINA_CONTEXT_PRINCIPAL_ID.
# CONTEXT_API_TOKEN authorizes POST /context/query, POST /mcp, and the read-only
# context projections. In production it is server-side bound to the tenant/principal
# below; request headers may repeat that binding but cannot override it. Neither
# static token may begin with jina_atk_, which is reserved for issued per-principal
# tokens and is refused at startup.
# INTERNAL_API_TOKEN=replace-with-a-random-service-token
# CONTEXT_API_TOKEN=replace-with-a-random-context-token
# JINA_CONTEXT_TENANT_ID=omlabs
# JINA_CONTEXT_PRINCIPAL_ID=user:context-query@example.com
# Exact browser origins allowed to call POST /mcp.
# JINA_MCP_ALLOWED_ORIGINS=https://app.example.com

# fixed uses JINA_TENANT_ID. shared-db resolves original tenant UUIDs from public
# identity tables in the same database.
# JINA_TENANCY_MODE=fixed
# JINA_TENANT_ID=omlabs
# Optional aliases migrated to the canonical tenant at startup in fixed mode.
# JINA_TENANT_ALIASES=github:unscoped,e2e-production,e2e
# Comma-separated principals allowed to administer the tenant.
# JINA_TENANT_ADMIN_PRINCIPALS=user:operator@example.com

# Per-process listener. Defaults: API 4000, dashboard 3000, worker 8080.
PORT=4000

# Local demo only. Never enable the unsigned endpoint in production.
JINA_ENABLE_DEV_ENDPOINTS=false
JINA_SIMULATE_RUNS=false
JINA_SEED_DEMO=false

# PostgreSQL. DATABASE_URL is convenient locally. Cloud Run uses the individual
# values and a Cloud SQL Unix socket.
# DATABASE_URL=postgresql://jina_app:password@localhost:5432/jina
# INSTANCE_UNIX_SOCKET=/cloudsql/project:region:instance
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=jina
# DB_USER=jina_app
# DB_PASS=replace-with-a-random-password
# Production migration jobs use a distinct schema-owning login/password secret:
# JINA_MIGRATION_DB_USER=jina_app
# JINA_MIGRATION_DB_PASS_SECRET=jina-db-password:latest
# With --install-roles, identify the NOINHERIT runtime login that receives membership
# in the context capability roles.
# CONTEXT_RUNTIME_DB_USER=jina_v2_app
# Set false after an administrator has run `pnpm --filter @jina/db migrate`.
# JINA_DB_MANAGE_SCHEMA=true
# Roles require CREATEROLE and are normally installed by the migration job.
# JINA_DB_MANAGE_ROLES=false
# Optional pgvector installation is an administrative migration flag
# (`pnpm --filter @jina/db migrate -- --install-pgvector`), not an API setting.
# Dense retrieval remains disabled unless an approved provider is evaluated.

# Dashboard, admin, worker, and acceptance processes call this server-side URL.
# JINA_API_URL=http://localhost:4000

# Production acceptance uses a non-admin principal for HTTP/MCP query and a distinct
# tenant administrator for build, catalog, metrics, and backlog assertions.
# ACCEPTANCE_TENANT_ID=omlabs
# ACCEPTANCE_PRINCIPAL_ID=user:context-query@example.com
# ACCEPTANCE_ADMIN_PRINCIPAL_ID=user:operator@example.com
# ACCEPTANCE_REPOSITORY=owner/repository
# ACCEPTANCE_REF=main
# ACCEPTANCE_REQUEST_KEY=acceptance-unique-key
# ACCEPTANCE_GITHUB_INSTALLATION_ID=123456
# ACCEPTANCE_TIMEOUT_MS=3000000

# Web apps use server-only app authentication. Never use NEXT_PUBLIC_ names.
# JINA_WEB_AUTH_USERNAME=omlabs
# JINA_WEB_AUTH_PASSWORD=replace-with-a-random-password
# Required by dashboard API calls and by admin when JINA_TENANT_ID is absent.
# JINA_WEB_PRINCIPAL_ID=user:operator@example.com
# JINA_ADMIN_ALLOWED_EMAILS=operator@example.com,oncall@example.com

# Deploy context and ordinary work as separate one-concurrency worker services.
# Commas work locally; use pipes in Cloud Run because its CLI reserves commas.
# WORKER_TOPICS=run-review
# WORKER_TOPICS=run-ingest-evidence,run-derive-knowledge,run-index-context
# WORKER_ID=local-worker
# WORKER_POLL_INTERVAL_MS=2000
# WORKER_HEARTBEAT_INTERVAL_MS=60000
# WORKER_IDLE_DRAIN_INTERVAL_MS=60000
# CONTEXT_API_TIMEOUT_MS=900000

# Repository evidence intake. Webhook builds carry the GitHub App installation ID;
# the context worker mints a short-lived installation token for clone and REST access.
# GITHUB_APP_ID=...
# GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Manual builds without an installation ID may use one of these read-only fallbacks.
# GITHUB_API_TOKEN=...
# GITHUB_CLONE_TOKEN=...
# GITHUB_API_URL=https://api.github.com
# GITHUB_RETRY_ATTEMPTS=4
# GITHUB_RETRY_BASE_MS=1000
# CONTEXT_GITHUB_HISTORY_LIMIT=500
# Number of Git commits/parents persisted from the exact head. Hitting the bound marks
# source completeness partial; the worker never silently reports a complete history.
# CONTEXT_GIT_HISTORY_LIMIT=5000
# CONTEXT_MAX_FILE_BYTES=5242880
# CONTEXT_MAX_SNAPSHOT_BYTES=8388608

# Isolated knowledge-document derivation.
# DAYTONA_API_KEY=...
# OPENAI_API_KEY=...
# OPENROUTER_API_KEY=...
# CONTEXT_CODEX_PROVIDER=openai
# CONTEXT_CODEX_MODEL=openai/gpt-5.4-mini
# CONTEXT_CODEX_EFFORT=medium
# CONTEXT_CODEX_EXECUTION_ATTEMPTS=2
# CONTEXT_CODEX_RETRY_DELAY_SECONDS=10
# CONTEXT_CODEX_CONTEXT_TOKENS=64000
# CONTEXT_CODEX_COMPACT_TOKENS=48000
# CONTEXT_AGENT_ARCHIVE_MAX_BYTES=134217728
# DAYTONA_RUN_TIMEOUT_SECONDS=1800
# DAYTONA_SETUP_TIMEOUT_SECONDS=300
# DAYTONA_RESULT_DOWNLOAD_TIMEOUT_SECONDS=120
# Optional prebuilt Daytona snapshot containing a working Codex binary.
# DAYTONA_SNAPSHOT=...
# DAYTONA_SANDBOX_IMAGE=node:22-bookworm
# DAYTONA_SANDBOX_CPU=4
# DAYTONA_SANDBOX_MEMORY=8
# DAYTONA_SANDBOX_DISK=10

# Ordinary pull-request review worker (separate from context derivation).
# REVIEW_MODEL=gpt-5.6-sol
# OPENAI_API_URL=https://api.openai.com/v1
