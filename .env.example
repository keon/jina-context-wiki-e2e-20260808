# Required for POST /webhooks/github. Use the same high-entropy value in the GitHub App settings.
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret

# Required with INTERNAL_API_TOKEN in production. The dashboard and worker keep
# this service credential server-side; browsers cannot choose another tenant.
# JINA_TENANT_ID=omlabs
# Optional one-time aliases migrated to the canonical tenant on startup.
# JINA_TENANT_ALIASES=github:unscoped,e2e-production,e2e
# Comma-separated application principals that may administer the tenant.
# JINA_TENANT_ADMIN_PRINCIPALS=user:operator@example.com
# INTERNAL_API_TOKEN=replace-with-a-random-service-token
# Read-only credential for the admin app's cross-tenant graph-head index. It
# must differ from INTERNAL_API_TOKEN and remains server-only.
# JINA_GLOBAL_ADMIN_TOKEN=replace-with-a-different-random-admin-token
# Dedicated credential for graph routes and repository ACL synchronization.
# GRAPH_API_TOKEN=replace-with-a-random-graph-token
# Exact browser origins allowed to call POST /mcp.
# JINA_MCP_ALLOWED_ORIGINS=https://app.example.com

# Per-process listener. Defaults: API 4000, dashboard 3000, worker 8080.
PORT=4000

# Local demo only. Never enable the unsigned endpoint in production.
JINA_ENABLE_DEV_ENDPOINTS=false
JINA_SIMULATE_RUNS=false
JINA_SEED_DEMO=false

# Optional Postgres persistence. DATABASE_URL is convenient locally. Cloud Run
# uses the individual values with a Cloud SQL Unix socket and Secret Manager.
# DATABASE_URL=postgresql://jina_app:password@localhost:5432/jina
# INSTANCE_UNIX_SOCKET=/cloudsql/project:region:instance
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=jina
# DB_USER=jina_app
# DB_PASS=replace-with-a-random-password
# Production isolates ContextGraph ingestion on a second PostgreSQL instance.
# Omit every GRAPH_* value locally to reuse the primary connection above.
# GRAPH_DATABASE_URL=postgresql://jina_app:password@localhost:5433/jina
# GRAPH_INSTANCE_UNIX_SOCKET=/cloudsql/project:region:graph-instance
# GRAPH_DB_HOST=127.0.0.1
# GRAPH_DB_PORT=5433
# GRAPH_DB_NAME=jina
# GRAPH_DB_USER=jina_app
# GRAPH_DB_PASS=replace-with-a-different-random-password
# Set false after an administrator has run `pnpm --filter @jina/db migrate`.
# JINA_DB_MANAGE_SCHEMA=true

# fixed uses JINA_TENANT_ID. shared-db resolves original Jina tenant UUIDs from
# the public identity tables in the same database used for Jina v2 state.
# JINA_TENANCY_MODE=fixed

# Dashboard, admin, and worker processes call the API through this server-side URL.
# JINA_API_URL=http://localhost:4000

# Vercel deployments use app-level HTTP authentication. Keep these values
# server-only; the dashboard forwards the fixed principal to the API after
# validating the credentials. Never use NEXT_PUBLIC_ names.
# JINA_WEB_AUTH_USERNAME=omlabs
# JINA_WEB_AUTH_PASSWORD=replace-with-a-random-password
# JINA_WEB_PRINCIPAL_ID=user:operator@example.com

# Admin app (apps/admin) inbound authentication. JINA_GLOBAL_ADMIN_TOKEN lists
# graph heads across tenants; INTERNAL_API_TOKEN reads and queries a selected
# graph inside its tenant. Configuring either credential requires the web
# credentials above or Google IAP and the optional allowlist.
# JINA_ADMIN_ALLOWED_EMAILS=operator@example.com,oncall@example.com

# Worker process. Deploy context graph and task topics as separate one-concurrency
# services so a long Daytona run cannot delay review work. Commas work locally;
# use pipes in Cloud Run because its CLI reserves commas for environment entries.
# WORKER_TOPICS=run-review,run-research,run-publish,run-cleanup
# ContextGraph service: run-context-graph-ingest,run-context-graph-assert,run-context-graph-project
# WORKER_ID=local-worker
# WORKER_POLL_INTERVAL_MS=2000
# WORKER_HEARTBEAT_INTERVAL_MS=60000
# WORKER_IDLE_DRAIN_INTERVAL_MS=60000
# CONTEXT_GRAPH_API_TIMEOUT_MS=900000
# REVIEW_MODEL=gpt-5.6-sol
# OPENAI_API_URL=https://api.openai.com/v1
# GITHUB_API_URL=https://api.github.com
# GITHUB_RETRY_ATTEMPTS=4
# GITHUB_RETRY_BASE_MS=1000

# Context graph repository inspection and assertion generation.
# DAYTONA_API_KEY=...
# Optional override; otherwise the worker creates/reuses jina-context-graph-codex-0-145-0.
# DAYTONA_SNAPSHOT=...
# GITHUB_APP_ID=...
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional legacy credentials for non-graph review tasks only.
# GITHUB_CLONE_TOKEN=...
# Optional dedicated legacy REST API credential. Falls back to GITHUB_CLONE_TOKEN.
# GITHUB_API_TOKEN=...
# OPENAI_API_KEY=...
# OPENROUTER_API_KEY=...
# Required by the API before tenant administrators can connect Codex or BYOK.
# Generate once with `openssl rand -base64 32`; rotate only with a credential
# re-encryption plan because existing envelopes are bound to this key.
# SECRETS_ENCRYPTION_KEY=replace-with-base64-encoded-32-bytes
# CONTEXT_GRAPH_MODEL=openai/gpt-5.6-luna
# CONTEXT_GRAPH_MODEL_TIMEOUT_MS=600000
# CONTEXT_GRAPH_MODEL_VALIDATION_ATTEMPTS=3
# CONTEXT_GRAPH_CODEX_EXECUTION_ATTEMPTS=2
# CONTEXT_GRAPH_CODEX_RETRY_DELAY_SECONDS=10
# CONTEXT_GRAPH_CODEX_EFFORT=medium
# CONTEXT_GRAPH_HISTORY_LIMIT=10000
# CONTEXT_GRAPH_ASSERTION_FOCUS_LIMIT=200
# CONTEXT_GRAPH_GITHUB_PR_CONCURRENCY=4
# CONTEXT_GRAPH_FOCUS_BUNDLE_FILE_LIMIT=32
# CONTEXT_GRAPH_FOCUS_BUNDLE_MAX_CHARS=16000
# CONTEXT_GRAPH_FOCUS_BUNDLE_FILE_CHARS=3000
# CONTEXT_GRAPH_CODEX_CONTEXT_TOKENS=256000
# CONTEXT_GRAPH_CODEX_COMPACT_TOKENS=200000
# DAYTONA_RUN_TIMEOUT_SECONDS=1800
# DAYTONA_SETUP_TIMEOUT_SECONDS=300
# DAYTONA_RESULT_DOWNLOAD_TIMEOUT_SECONDS=120
# DAYTONA_SNAPSHOT_SETUP_TIMEOUT_SECONDS=1200
# DAYTONA_SANDBOX_CPU=4
# DAYTONA_SANDBOX_MEMORY=8
# DAYTONA_SANDBOX_DISK=10
