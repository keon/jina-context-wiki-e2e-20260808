# Required for POST /webhooks/github. Use the same high-entropy value in the GitHub App settings.
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret

# Required with INTERNAL_API_TOKEN in production. The dashboard and worker keep
# this service credential server-side; browsers cannot choose another tenant.
# JINA_TENANT_ID=tenant_local
# INTERNAL_API_TOKEN=replace-with-a-random-service-token

PORT=4000

# Local demo only. Never enable the unsigned endpoint in production.
JINA_ENABLE_DEV_ENDPOINTS=false
JINA_SIMULATE_RUNS=false
JINA_SEED_DEMO=false

# Optional Postgres persistence. DATABASE_URL is convenient locally. Cloud Run
# uses the individual values with a Cloud SQL Unix socket and Secret Manager.
# DATABASE_URL=postgresql://jina_app:password@localhost:5432/jina
# INSTANCE_UNIX_SOCKET=/cloudsql/project:region:instance
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=jina
# DB_USER=jina_app
# DB_PASS=replace-with-a-random-password

# Ontology worker process only.
# JINA_API_URL=http://localhost:4000
# DAYTONA_API_KEY=...
# GITHUB_CLONE_TOKEN=...
# OPENAI_API_KEY=...
